extends layout

block content
  include _steps
  +steps(1)

  h1 Choose a doctor
  p.lede Pick who you'd like to see. You'll choose a time next.

  if error
    .alert.alert-error(role="alert")= error

  if doctors.length === 0
    .empty
      p No doctors have appointment times right now. Please check back later.
  else
    ul.doctors
      each d in doctors
        li
          if d.open > 0
            a.doctor-card(href=d.url)
              span.avatar(aria-hidden="true")= d.initials
              span.doctor-main
                span.doctor-name= d.name
                span.doctor-meta Next opening: #{d.next.date}, #{d.next.startTime}
              span.doctor-count #{d.open} open
              span.chevron(aria-hidden="true") ›
          else
            .doctor-card.doctor-full
              span.avatar(aria-hidden="true")= d.initials
              span.doctor-main
                span.doctor-name= d.name
                span.doctor-meta Fully booked
              span.doctor-count 0 open
