extends layout

block content
  include _steps
  +steps(1)

  h1 Choose a doctor
  p.lede Pick who you'd like to see. You'll choose a time next.

  if error
    .alert.alert-error(role="alert")= error

  if doctors.length === 0
    .empty
      p No doctors have appointment times right now. Please check back later.
  else
    ul.doctors
      each d in doctors
        li
          if d.open > 0
            a.doctor-card(href=d.url)
              span.avatar(aria-hidden="true")= d.initials
              h2.doctor-name= d.name
              p.doctor-meta Next opening
              p.doctor-next #{d.next.date}, #{d.next.startTime}
              span.doctor-foot
                span.doctor-count #{d.open} open #{d.open === 1 ? 'time' : 'times'}
                span.doctor-cta See times ›
          else
            .doctor-card.doctor-full
              span.avatar(aria-hidden="true")= d.initials
              h2.doctor-name= d.name
              p.doctor-meta Next opening
              p.doctor-next None right now
              span.doctor-foot
                span.doctor-count Fully booked
